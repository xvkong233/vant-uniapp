{
  "name": "vant-uniapp",
  "version": "0.1.0",
  "author": "vant-ui",
  "license": "MIT",
  "description": "轻量、可靠的 uni-app Vue3 UI 组件库，迁移自 Vant Weapp 并兼容 Vant 4 H5 生态",
  "type": "module",
  "main": "dist/vant-uniapp/es/index.js",
  "module": "dist/vant-uniapp/es/index.js",
  "types": "dist/vant-uniapp/es/index.d.ts",
  "files": [
    "dist/vant-uniapp/**",
    "README.md",
    "LICENSE",
    "MIGRATION_UNI_APP.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/vant-uniapp/es/index.d.ts",
      "import": "./dist/vant-uniapp/es/index.js",
      "default": "./dist/vant-uniapp/es/index.js"
    },
    "./es/*": "./dist/vant-uniapp/es/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvkong233/vant-uniapp.git"
  },
  "homepage": "https://github.com/xvkong233/vant-uniapp#readme",
  "keywords": [
    "vant",
    "uni-app",
    "vue3",
    "components",
    "wechat-miniprogram"
  ],
  "scripts": {
    "dev": "uni -p h5",
    "dev:h5": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "uni build -p h5",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:package": "node scripts/build-package.mjs",
    "audit:migration": "node scripts/audit-uni-migration.mjs",
    "pack:check": "cd dist/vant-uniapp && npm pack --dry-run",
    "prepublishOnly": "npm run audit:migration && npm run typecheck && npm run build:h5 && npm run build:mp-weixin && npm run build:package && npm run pack:check",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@dcloudio/uni-app": ">=3.0.0",
    "@dcloudio/uni-components": ">=3.0.0",
    "vant": ">=4.0.0",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5010220260604001",
    "@dcloudio/uni-components": "3.0.0-alpha-5010220260604001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5010220260604001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5010220260604001",
    "@dcloudio/types": "^3.4.17",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010220260604001",
    "@vitejs/plugin-vue": "^5.2.0",
    "less": "^4.2.0",
    "typescript": "^5.4.2",
    "vant": "^4.9.0",
    "vite": "^5.2.8",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.1",
    "vue-tsc": "^2.1.10"
  },
  "browserslist": [
    "Chrome >= 87",
    "iOS >= 12",
    "Android >= 7"
  ]
}
